# Copy to .env.local for local runs. On Vercel, set these under Settings > Environment Variables.

# Test entity with NomuPay Wallets brands enabled
ENTITY_ID=
ACCESS_TOKEN=

# Optional: entity used whenever a checkout includes cards (falls back to ENTITY_ID / ACCESS_TOKEN)
# CARD_ENTITY_ID=
# CARD_ACCESS_TOKEN=

# Gateway host. Defaults to eu-test.oppwa.com
API_HOST=eu-test.oppwa.com

# Optional: testMode sent with APMs on test hosts (defaults to EXTERNAL, the NomuPay Wallets simulator).
# Set to an empty value to leave it out.
# TEST_MODE=EXTERNAL

# Optional: fixed public URL used for return URLs (defaults to the request's host)
# PUBLIC_BASE_URL=https://nomupay-apm-demo.vercel.app
